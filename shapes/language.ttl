@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix kbv:  <https://id.kb.se/vocab/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

kbv:languageShape
    a sh:PropertyShape ;
    sh:path kbv:language ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    skos:closeMatch <http://rdaregistry.info/Elements/w/P10353> ;
    sh:deactivated true ;
    sh:severity sh:violation ;
    sh:message ""Obligatoriskt…". @sv."@sv .
