@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix kbv:  <https://id.kb.se/vocab/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

kbv:PlaceShape
    a sh:NodeShape ;
    sh:property kbv:nameShape ;
    sh:property kbv:identifiedByShape ;
    sh:property kbv:birthPlaceShape ;
    sh:property kbv:deathPlaceShape ;
    sh:property kbv:categoryShape ;
    sh:property kbv:JurisdictionShape .
