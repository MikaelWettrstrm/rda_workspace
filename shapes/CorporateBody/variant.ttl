@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix kbv:  <https://id.kb.se/vocab/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

kbv:variantShape
    a sh:PropertyShape ;
    sh:path kbv:variant ;
    sh:nodeKind sh:IRI ;
    skos:closeMatch <http://rdaregistry.info/Elements/a/P50025> ;
    sh:deactivated true ;
    sh:severity sh:warning ;
    sh:message ""Obligatoriskt om nödvändigt för identifikation eller åtkomst."@sv." .
