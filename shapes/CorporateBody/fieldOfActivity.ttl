@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix kbv:  <https://id.kb.se/vocab/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

kbv:fieldOfActivityShape
    a sh:PropertyShape ;
    sh:path kbv:fieldOfActivity ;
    sh:nodeKind sh:IRI ;
    skos:exactMatch <http://rdaregistry.info/Elements/a/P50022> ;
    sh:deactivated true .
