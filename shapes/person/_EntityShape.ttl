@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix kbv:  <https://id.kb.se/vocab/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

kbv:PersonShape
    a sh:NodeShape ;
    sh:property kbv:nameShape ;
    sh:property kbv:familyNameShape ;
    sh:property kbv:givenNameShape ;
    sh:property kbv:birthDateShape ;
    sh:property kbv:deathDateShape ;
    sh:property kbv:activityStartDateShape ;
    sh:property kbv:activityEndDateShape ;
    sh:property kbv:fullerFormOfNameShape ;
    sh:property kbv:hasOccupationShape ;
    sh:property kbv:identifiedByShape ;
    sh:property kbv:descriptionShape ;
    sh:property kbv:seeAlsoShape ;
    sh:property kbv:cataloguersNoteShape .
